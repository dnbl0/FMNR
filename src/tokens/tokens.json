{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "$type": "color",
    "green": {
      "900": { "$value": "#255238", "$description": "Dark forest green — primary brand, backgrounds" },
      "800": { "$value": "#265138", "$description": "Deep forest green" },
      "700": { "$value": "#39513b", "$description": "Mid-dark forest green" },
      "300": { "$value": "#a0cba3", "$description": "Light sage green" },
      "200": { "$value": "#aae5aa", "$description": "Pale mint green" },
      "100": { "$value": "#bce4ac", "$description": "Very light green" }
    },
    "blue": {
      "900": { "$value": "#244164", "$description": "Deep navy — secondary brand" },
      "700": { "$value": "#345273", "$description": "Mid navy blue" },
      "200": { "$value": "#b6c3cf", "$description": "Light blue-grey" }
    },
    "orange": {
      "600": { "$value": "#ff6b00", "$description": "Vivid orange — accent / CTA" },
      "500": { "$value": "#e06a18", "$description": "Warm orange" },
      "400": { "$value": "#d66a2b", "$description": "Earthy orange" },
      "300": { "$value": "#b96a28", "$description": "Burnt sienna" }
    },
    "yellow": {
      "500": { "$value": "#cea634", "$description": "Warm gold" },
      "400": { "$value": "#dfa922", "$description": "Sunflower yellow" },
      "300": { "$value": "#dfeb58", "$description": "Bright yellow-green" },
      "200": { "$value": "#e2ea64", "$description": "Pale lime yellow" }
    },
    "warm": {
      "200": { "$value": "#d9c8a0", "$description": "Warm sand" },
      "100": { "$value": "#ede8db", "$description": "Off-white / warm paper" }
    },
    "neutral": {
      "900": { "$value": "#1f1f1e", "$description": "Near black — primary text" },
      "700": { "$value": "#464646", "$description": "Dark grey — secondary text" },
      "500": { "$value": "#7f7f7f", "$description": "Mid grey — muted text" },
      "100": { "$value": "#f1f1f1", "$description": "Light grey — surface / dividers" },
      "0":   { "$value": "#ffffff", "$description": "White" }
    }
  },
  "semantic": {
    "brand": {
      "primary":   { "$value": "{color.green.900}" },
      "secondary": { "$value": "{color.blue.900}" },
      "accent":    { "$value": "{color.orange.600}" }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.900}" },
      "secondary": { "$value": "{color.neutral.700}" },
      "muted":     { "$value": "{color.neutral.500}" },
      "inverse":   { "$value": "{color.neutral.0}" },
      "on-brand":  { "$value": "{color.neutral.0}" }
    },
    "background": {
      "base":      { "$value": "{color.neutral.0}" },
      "subtle":    { "$value": "{color.neutral.100}" },
      "warm":      { "$value": "{color.warm.100}" },
      "brand":     { "$value": "{color.green.900}" },
      "accent":    { "$value": "{color.orange.600}" }
    },
    "border": {
      "default":   { "$value": "{color.neutral.100}" },
      "muted":     { "$value": "{color.blue.200}" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "$value": "'FatFrank', serif",
        "$description": "FatFrank Heavy — hero/display headings"
      },
      "heading": {
        "$value": "'Archivo Black', sans-serif",
        "$description": "Archivo Black — section headings"
      },
      "body": {
        "$value": "'Lato', sans-serif",
        "$description": "Lato — body copy, UI"
      }
    },
    "fontWeight": {
      "hairline": { "$value": "100" },
      "light":    { "$value": "300" },
      "regular":  { "$value": "400" },
      "bold":     { "$value": "700" },
      "black":    { "$value": "900" }
    },
    "fontSize": {
      "xs":   { "$value": "0.75rem",  "$description": "12px" },
      "sm":   { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem",     "$description": "16px" },
      "lg":   { "$value": "1.125rem", "$description": "18px" },
      "xl":   { "$value": "1.25rem",  "$description": "20px" },
      "2xl":  { "$value": "1.5rem",   "$description": "24px" },
      "3xl":  { "$value": "1.875rem", "$description": "30px" },
      "4xl":  { "$value": "2.25rem",  "$description": "36px" },
      "5xl":  { "$value": "3rem",     "$description": "48px" },
      "6xl":  { "$value": "4rem",     "$description": "64px" }
    },
    "lineHeight": {
      "tight":  { "$value": "1.2" },
      "snug":   { "$value": "1.375" },
      "normal": { "$value": "1.5" },
      "relaxed":{ "$value": "1.625" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.05em" },
      "wider":  { "$value": "0.1em" },
      "widest": { "$value": "0.15em" }
    }
  },
  "spacing": {
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },
  "borderRadius": {
    "none": { "$value": "0" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "12px" },
    "xl":   { "$value": "16px" },
    "full": { "$value": "9999px" }
  }
}
